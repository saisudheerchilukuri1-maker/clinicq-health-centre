# ClinicQ Health Centre - Environment Configuration Example

# Server Port (default: 3000)
PORT=3000

# Server Host (default: 0.0.0.0)
HOST=0.0.0.0

# Runtime Environment (development | test | production)
NODE_ENV=development

# Database File Path (default: ./database/clinicq.db)
DB_PATH=./database/clinicq.db
