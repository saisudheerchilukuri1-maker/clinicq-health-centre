                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"doctor_id\": 1,\n  \"room_id\": 1,\n  \"booking_date\": \"2026-11-20\",\n  \"booking_time\": \"09:00\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/bookings",
              "host": ["{{baseUrl}}"],
              "path": ["bookings"]
            },
            "description": "Attempt to book a slot that is already reserved. Returns 409 Conflict."
          }
        },
        {
          "name": "PUT Update Booking",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
